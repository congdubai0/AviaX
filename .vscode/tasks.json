{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install React dependencies",
			"type": "shell",
			"command": "npm install",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Mini App",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Run Mini App locally",
			"type": "shell",
			"command": "npm run dev -- --host 127.0.0.1",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Mini App with React plugin",
			"type": "shell",
			"command": "npm run dev -- --host 127.0.0.1 --port 5174",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}